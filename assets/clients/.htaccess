# Protect client photos - only allow specific file types
<FilesMatch "\.(jpg|jpeg|png|gif)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Prevent directory listing
Options -Indexes

# Prevent access to sensitive files
<FilesMatch "\.(php|phtml|php3|php4|php5|phps|cgi|pl|sh)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>
